<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qingyang.shakeblocker.daemon</string>

  <!-- rootless 下此路径由 postinst 用 sed 补成 /var/jb/usr/bin/shakeblockerd -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/shakeblockerd</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- 每 60 秒拉起一次（daemon 本身是一次性扫描进程，跑完即退出） -->
  <key>StartInterval</key>
  <integer>60</integer>

  <!-- rootless 下日志路径由 postinst 用 sed 补成 /var/jb/var/log/... -->
  <key>StandardOutPath</key>
  <string>/var/log/shakeblocker.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/shakeblocker.err.log</string>

  <key>UserName</key>
  <string>root</string>
</dict>
</plist>
